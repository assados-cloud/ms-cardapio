{
  "info": {
    "name": "Equipe 15 - Cardapio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Listar produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/cardapio/produtos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Buscar produto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/cardapio/produtos/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Produto inexistente",
